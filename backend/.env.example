# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/moneymint
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PORT=4000
# Razorpay (wallet top-up + per-user UPI QR). Leave blank to disable online top-up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set when adding the webhook URL in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Public base URL of this API, used to build the callback URL given to vendors.
PUBLIC_API_URL=http://localhost:4000
# Development only: uses the mock gateway (when no Razorpay keys are set) and enables
# /wallet/add-money/mock-pay and /mock-qr-pay, which credit a wallet without a real
# payment. Never set this in production.
ENABLE_MOCK_PAYMENTS=false
# Set to true to stop the background status checks of PENDING transactions.
DISABLE_STATUS_POLLER=false
# Behind a load balancer / reverse proxy: how many proxies to trust (e.g. 1), so the
# partner API's IP whitelist and rate limits see the real client IP.
TRUST_PROXY=
# Local testing only: allow partner callback URLs on localhost / private IPs.
ALLOW_PRIVATE_CALLBACKS=false
# Set to "production" on live servers (disables DEV_FIXED_OTP, among others).
NODE_ENV=development
# Test servers only: every OTP is this 6-digit code (SMS isn't connected). Ignored when
# NODE_ENV=production.
DEV_FIXED_OTP=
