# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/moneymint
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PORT=4000
# Must match the webhook secret registered with the payment gateway.
PAYMENT_WEBHOOK_SECRET=change-me
# Public base URL of this API, used to build the callback URL given to vendors.
PUBLIC_API_URL=http://localhost:4000
# Development only: enables /wallet/add-money/mock-pay, which credits a wallet without a
# real payment. Never set this in production.
ENABLE_MOCK_PAYMENTS=false
# Set to true to stop the background status checks of PENDING transactions.
DISABLE_STATUS_POLLER=false
