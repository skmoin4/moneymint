// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MASTER_DISTRIBUTOR
  DISTRIBUTOR
  RETAILER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerReferenceType {
  RECHARGE
  BBPS
  DMT
  AEPS
  FUND_TRANSFER
  COMMISSION
  REFUND
  ADJUSTMENT
  RENT
  CASHBACK
  REFERRAL_REWARD
  WALLET_TOPUP
  SURCHARGE
  GATEWAY_CHARGE
  BALANCE_REQUEST
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ProviderType {
  RECHARGE
  AEPS
  DMT
  BBPS
}

enum TransactionType {
  RECHARGE
  BBPS
  DMT
  AEPS
}

enum CommissionType {
  PERCENT
  FLAT
}

// COMMISSION = paid to the user on success. SURCHARGE = charged to the user on top of
// the amount (typical for DMT/BBPS), taken at debit time and refunded if it fails.
enum ChargeType {
  COMMISSION
  SURCHARGE
}

enum FundTransferStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BalanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String?    @unique
  phone        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  kycStatus    KycStatus  @default(NOT_SUBMITTED)

  // Consumer-app transaction PIN — a second factor confirming money-movement actions,
  // distinct from the login credential. Opt-in: enforced only when pinEnabled is true.
  transactionPinHash String?
  pinEnabled         Boolean @default(false)
  tokenVersion       Int     @default(0) // bumped on "Logout All Devices" to invalidate every previously issued JWT

  // Referral program: whoever referred this user earns a reward whenever this user
  // transacts successfully (see settleTransaction). referralCode is this user's own
  // code to hand out to others.
  referralCode  String? @unique
  referredById  String?
  referredBy    User?   @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]  @relation("Referrals")

  parentId String?
  parent   User?   @relation("UserHierarchy", fields: [parentId], references: [id])
  children User[]  @relation("UserHierarchy")

  wallet        Wallet?
  paymentOrders PaymentOrder[]

  commissionPackId String?
  commissionPack    CommissionPack? @relation(fields: [commissionPackId], references: [id])

  transactions      Transaction[]
  sentTransfers     FundTransfer[]  @relation("TransferFrom")
  receivedTransfers FundTransfer[]  @relation("TransferTo")
  remitters         Remitter[]
  kycRequests       KycRequest[]
  complaints        Complaint[]
  balanceRequests   BalanceRequest[]
  queuedRecharges   QueuedRecharge[]
  notifications     UserNotification[]
  commissionPayouts CommissionPayout[]
  apiCredential     ApiCredential?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String              @id @default(uuid())
  walletId      String
  wallet        Wallet              @relation(fields: [walletId], references: [id])
  type          LedgerEntryType
  amount        Decimal             @db.Decimal(14, 2)
  balanceAfter  Decimal             @db.Decimal(14, 2)
  referenceType LedgerReferenceType
  referenceId   String?
  description   String?
  createdAt     DateTime            @default(now())

  @@index([walletId])
  @@index([referenceType, referenceId])
}

model ApiProvider {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  providerType ProviderType
  baseUrl      String
  apiKey       String
  apiSecret    String
  isActive     Boolean      @default(true)
  rentAmount   Decimal      @default(0) @db.Decimal(14, 2)

  // Deeper per-provider integration config (mirrors AP Money's "Add API" form, trimmed to
  // fields that actually change engine behavior rather than being decorative).
  smsAlertOnSuccess Boolean @default(true)
  smsAlertOnFailure Boolean @default(true)
  retryCount        Int     @default(1) // attempts on this provider before failing over to the next priority slot
  gstPercent        Decimal @default(0) @db.Decimal(5, 2) // added on top when debiting rent

  // Real float the platform holds with this upstream vendor. Wallet 1 is the operational
  // balance: it auto-depletes on every successful transaction routed through this provider,
  // and a provider with insufficient Wallet 1 balance is skipped in the failover chain —
  // exactly like running out of prepaid balance with a real vendor. Wallet 2 is a secondary,
  // manually-managed reserve (e.g. a GST float) that admin tops up/debits by hand; nothing
  // automatically drains it.
  walletBalance          Decimal @default(0) @db.Decimal(14, 2)
  secondaryWalletBalance Decimal @default(0) @db.Decimal(14, 2)
  secondaryWalletLabel   String  @default("Wallet 2")

  // How requests reach this vendor. MOCK = built-in simulator (dev/testing). HTTP = a real
  // vendor described entirely by httpConfig (request template + response parsing rules,
  // the "API Parsing Setting" screen), so a new vendor needs configuration, not code.
  integrationType String  @default("MOCK")
  httpConfig      Json?
  // Secret embedded in the callback URL handed to the vendor; proves a callback is genuine.
  callbackToken   String? @unique

  operatorMappings OperatorApiMapping[]
  transactions     Transaction[]
  walletEntries    ProviderWalletEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderWalletEntry {
  id            String          @id @default(uuid())
  apiProviderId String
  apiProvider   ApiProvider     @relation(fields: [apiProviderId], references: [id])
  walletSlot    Int // 1 = operational (auto-depletes), 2 = manually-managed reserve
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(14, 2)
  balanceAfter  Decimal         @db.Decimal(14, 2)
  description   String?
  referenceId   String? // transaction id, when depleted by a successful transaction

  createdAt DateTime @default(now())

  @@index([apiProviderId])
}

model Operator {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  type     String // PREPAID, POSTPAID, DTH, ELECTRICITY, etc.
  isActive Boolean @default(true)

  apiMappings      OperatorApiMapping[]
  commissionSlabs  CommissionSlab[]
  transactions     Transaction[]
  prefixes         OperatorPrefix[]
  plans            RechargePlan[]
  cashbackOffers   CashbackOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperatorApiMapping {
  id            String      @id @default(uuid())
  operatorId    String
  operator      Operator    @relation(fields: [operatorId], references: [id])
  apiProviderId String
  apiProvider   ApiProvider @relation(fields: [apiProviderId], references: [id])
  priority      Int // 1 = primary, 2 = fallback, etc.
  isActive      Boolean     @default(true)
  // What this vendor pays the platform for this operator (e.g. 3.2% on Jio). The vendor
  // debits its float by amount − margin, and it is the top of the commission chain.
  vendorCommissionType  CommissionType?
  vendorCommissionValue Decimal?        @db.Decimal(8, 2)
  // This vendor's own code for the operator (vendors rarely agree: Jio may be "JIO", "RJ"
  // or "11"). Sent as {opcode}; falls back to Operator.code when empty.
  providerOperatorCode String?

  @@unique([operatorId, priority])
  @@index([apiProviderId])
}

model CommissionPack {
  id   String @id @default(uuid())
  name String @unique

  // Fallback rate applied when a transaction's operator has no specific slab in this pack.
  globalCommissionType CommissionType?
  globalValue          Decimal?        @db.Decimal(6, 2)

  slabs CommissionSlab[]
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One rate for one operator in one pack, optionally limited to an amount range — so DMT
// can be "₹100–1000: ₹10 surcharge, ₹1001–5000: 1%". An operator may have several slabs
// in a pack; the one whose range contains the amount applies (narrowest range wins).
model CommissionSlab {
  id             String         @id @default(uuid())
  packId         String
  pack           CommissionPack @relation(fields: [packId], references: [id])
  operatorId     String
  operator       Operator       @relation(fields: [operatorId], references: [id])
  chargeType     ChargeType     @default(COMMISSION)
  commissionType CommissionType
  value          Decimal        @db.Decimal(8, 2)
  minAmount      Decimal?       @db.Decimal(14, 2)
  maxAmount      Decimal?       @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packId, operatorId])
  @@index([operatorId])
}

// Who earned what on a successful transaction: level 0 is the user who transacted, 1
// their parent, and so on up the chain. Each upline earns the difference between its own
// pack rate and the best rate below it. The platform keeps vendor margin − all payouts.
model CommissionPayout {
  id            String   @id @default(uuid())
  transactionId String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  level         Int
  role          Role
  gross         Decimal  @db.Decimal(14, 2)
  tds           Decimal  @default(0) @db.Decimal(14, 2)
  net           Decimal  @db.Decimal(14, 2)
  reversed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([transactionId])
  @@index([userId, createdAt])
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  operatorId    String
  operator      Operator          @relation(fields: [operatorId], references: [id])
  apiProviderId String
  apiProvider   ApiProvider       @relation(fields: [apiProviderId], references: [id])

  type           TransactionType @default(RECHARGE)
  identifier     String // mobile number for RECHARGE, consumer/account number for BBPS
  amount         Decimal @db.Decimal(14, 2)
  commission     Decimal @default(0) @db.Decimal(14, 2)
  // Charged to the user on top of amount (deduction = amount + surcharge).
  surcharge      Decimal @default(0) @db.Decimal(14, 2)
  // Margin the vendor gave the platform on this transaction (set on success).
  vendorCommission Decimal @default(0) @db.Decimal(14, 2)
  deduction      Decimal @db.Decimal(14, 2)

  status        TransactionStatus @default(PENDING)
  providerRefId String?
  apiResponse   Json?
  // Where the request came from: APP (retailer mobile app), WEB (admin/retailer web
  // panel), API (an API user's server), MANUAL (admin "Add Transaction"), QUEUE
  // (a scheduled Q-Recharge). Shown as the "Source" column in Transaction History.
  source        String            @default("APP")
  // The vendor's own id for this transaction (distinct from the operator ref above);
  // used to match callbacks and run status checks.
  vendorRefId       String?
  statusMessage     String?
  // API users' own reference for this request; unique per user so a retried request
  // can never recharge twice.
  clientRef         String?
  statusCheckCount  Int       @default(0)
  lastStatusCheckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([identifier])
  @@index([createdAt])
  @@index([vendorRefId])
  @@unique([userId, clientRef])
}

// Every request we send to a vendor and every callback a vendor sends us, with secrets
// masked. This is the first place to look when a vendor disputes a transaction.
model ProviderCallLog {
  id             String   @id @default(uuid())
  apiProviderId  String
  transactionId  String?
  kind           String // REQUEST, STATUS_CHECK, CALLBACK
  method         String?
  url            String?
  requestBody    String?
  httpStatus     Int?
  responseBody   String?
  parsedStatus   String? // SUCCESS, FAILED, PENDING, ERROR
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([transactionId])
  @@index([apiProviderId, createdAt])
}

model FundTransfer {
  id          String              @id @default(uuid())
  fromUserId  String
  fromUser    User                @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User                @relation("TransferTo", fields: [toUserId], references: [id])
  amount      Decimal             @db.Decimal(14, 2)
  paymentMode String
  utrNumber   String?
  status      FundTransferStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
}

model Remitter {
  id          String   @id @default(uuid())
  userId      String // retailer who registered this remitter
  user        User     @relation(fields: [userId], references: [id])
  name        String
  mobileNumber String  @unique
  isVerified  Boolean  @default(false)

  beneficiaries Beneficiary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Beneficiary {
  id            String   @id @default(uuid())
  remitterId    String
  remitter      Remitter @relation(fields: [remitterId], references: [id])
  name          String
  accountNumber String
  ifsc          String
  bankName      String

  createdAt DateTime @default(now())

  @@index([remitterId])
}

model KycRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  aadhaarNumber String
  panNumber     String
  status        KycStatus @default(PENDING)
  remarks       String?
  reviewedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Complaint {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  adminRemarks String?
  transactionRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model BankAccount {
  id            String   @id @default(uuid())
  accountName   String
  accountNumber String
  ifsc          String
  bankName      String
  upiId         String?
  isActive      Boolean  @default(true)
  // Whose account this is. null = the company's own account (shown to users whose
  // parent is the admin); otherwise a Master Distributor's / Distributor's account,
  // shown to their direct downline for balance requests.
  ownerId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Notice {
  id       String  @id @default(uuid())
  message  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BalanceRequest {
  id         String               @id @default(uuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  amount     Decimal              @db.Decimal(14, 2)
  utrNumber  String
  status     BalanceRequestStatus @default(PENDING)
  remarks    String?
  qrSettled  Boolean              @default(false)
  bankAccountId String? // the account the money was deposited into
  paymentMode   String? // NEFT / IMPS / UPI / CASH …
  depositedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  details   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model IpWhitelistEntry {
  id          String   @id @default(uuid())
  ipAddress   String   @unique
  description String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
}

model SmsLog {
  id       String  @id @default(uuid())
  toPhone  String
  message  String
  purpose  String // OTP, TRANSACTION_ALERT, ANNOUNCEMENT, etc.
  status   String // SENT, FAILED
  provider String

  createdAt DateTime @default(now())

  @@index([toPhone])
  @@index([createdAt])
}

model Circle {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  state    String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PaymentMode {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

model WhatsappLog {
  id       String @id @default(uuid())
  toPhone  String
  message  String
  status   String // SENT, FAILED
  provider String

  createdAt DateTime @default(now())

  @@index([toPhone])
}

model EmailLog {
  id       String @id @default(uuid())
  toEmail  String
  subject  String
  message  String
  status   String // SENT, FAILED
  provider String

  createdAt DateTime @default(now())

  @@index([toEmail])
}

model OtpRequest {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([phone])
}

enum QueuedRechargeStatus {
  QUEUED
  PROCESSED
  FAILED
  CANCELLED
}

model QueuedRecharge {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  operatorCode  String
  identifier    String
  amount        Decimal              @db.Decimal(14, 2)
  scheduledFor  DateTime
  status        QueuedRechargeStatus @default(QUEUED)
  resultMessage String?
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model UserNotification {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// Best-guess mobile-number-series -> operator mapping for "auto-detect operator as you
// type" in the app. Heuristic only (numbers can port between operators via MNP) — the
// app should still let the user override it, same as AP Money's own disclaimer.
model OperatorPrefix {
  id         String   @id @default(uuid())
  prefix     String   @unique // digits only, e.g. "981", "70"
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  createdAt DateTime @default(now())

  @@index([operatorId])
}

model RechargePlan {
  id          String   @id @default(uuid())
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  validity    String? // e.g. "28 days"
  data        String? // e.g. "1.5GB/day"
  talktime    String?
  sms         String?
  description String?
  category    String   @default("Popular") // Popular, Data, Unlimited, Topup, ...
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

// Promotional cashback campaigns — distinct from the standing per-user Commission pack.
// Admin can run a time-boxed "5% back on Jio recharges" offer; the best matching active
// offer is applied automatically on every successful transaction.
model CashbackOffer {
  id          String    @id @default(uuid())
  name        String
  operatorId  String? // null = applies to every operator
  operator    Operator? @relation(fields: [operatorId], references: [id])
  minAmount   Decimal   @default(0) @db.Decimal(14, 2)
  percent     Decimal   @db.Decimal(5, 2)
  maxCashback Decimal? @db.Decimal(14, 2)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

// A wallet top-up initiated through a real payment gateway (Razorpay/Cashfree/PayU in
// production; MockPaymentGatewayService today). Created PENDING when the app requests
// checkout params, then flipped to PAID/FAILED only by the signed webhook callback —
// never by the client claiming success, since that would let anyone credit their own
// wallet for free.
model PaymentOrder {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id])
  amount           Decimal @db.Decimal(14, 2)
  gatewayOrderId   String  @unique
  gatewayPaymentId String?
  provider         String  @default("MOCK_GATEWAY")
  status           String  @default("PENDING") // PENDING, PAID, FAILED
  // GATEWAY = user paid through checkout; QR = money arrived on the user's static UPI QR
  // (for QR rows gatewayOrderId holds the gateway's payment id, which keeps them unique).
  channel          String  @default("GATEWAY")
  method           String? // upi, card, netbanking, wallet…
  charges          Decimal @default(0) @db.Decimal(14, 2)
  netAmount        Decimal? @db.Decimal(14, 2)
  failureReason    String?
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([channel, status, createdAt])
}

// A user's own static UPI QR from the payment gateway: anyone paying it tops up that
// user's wallet automatically (gateway webhook → credit), no request or approval needed.
model UserPaymentQr {
  id         String   @id @default(uuid())
  userId     String   @unique
  provider   String
  externalId String   @unique // gateway's QR id
  upiId      String?
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// API access for a B2B partner ("API user"): their server calls /api/v1 with this token.
// Only a SHA-256 hash of the token is stored; the token itself is shown once when generated.
model ApiCredential {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  isActive       Boolean   @default(true) // admin switch
  tokenHash      String?   @unique
  tokenPrefix    String? // first characters, to recognise which token is in use
  allowedIps     String    @default("") // comma separated; requests from other IPs are refused
  callbackUrl    String?
  callbackMethod String    @default("POST") // POST (JSON) or GET (query string)
  callbackSecret String // signs callbacks (HMAC-SHA256) so the partner can verify them
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Outcome notifications to API users' callback URLs, retried with backoff until the
// partner answers 2xx.
model PartnerCallback {
  id            String    @id @default(uuid())
  userId        String
  transactionId String
  url           String
  method        String
  payload       String
  status        String    @default("PENDING") // PENDING, SENT, FAILED
  attempts      Int       @default(0)
  lastHttpStatus Int?
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([transactionId])
}
